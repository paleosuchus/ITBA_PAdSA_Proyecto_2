%% @brief Colour palette: navy, gold, grey, cream.  No aliases — each colour is defined once and used by name (e.g. \textcolor{navy}{...}).
%% @note  A class that wants a monochrome variant re-points the names with
%%        \colorlet rather than branching at every use site.
\definecolor{navy}{RGB}{25,55,90}
\definecolor{gold}{RGB}{185,140,50}
\definecolor{grey}{RGB}{105,105,105}
\definecolor{cream}{RGB}{247,243,231}

%% @brief Fill of the header row of a table.  The default is a plain grey that reads the same in every layout; a document re-points it to tint the row, e.g. \colorlet{headrowcolor}{gold!20} or \colorlet{headrowcolor}{navy!10}.
%% @note Deliberately independent of the colour option: a table looks the same whether or not the rest of the document is in colour, so the same source gives the same table everywhere.
\colorlet{headrowcolor}{grey!15}

% Spacing (display-math skips match size10.clo; no \everydisplay) Third-level headings are switched off: they are not numbered and stay out of the contents.
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}
\RequirePackage[skip=0.5em plus 2pt minus 1pt, indent=1em]{parskip}
\linespread{1.08}
\setlength{\abovedisplayskip}{10pt plus 2pt minus 5pt}
\setlength{\belowdisplayskip}{10pt plus 2pt minus 5pt}
\setlength{\abovedisplayshortskip}{0pt plus 3pt}
\setlength{\belowdisplayshortskip}{5pt plus 2.5pt minus 2pt}

% Captions
\addto\captionsspanish{\renewcommand{\figurename}{FIGURA}}
\addto\captionsspanish{\renewcommand{\tablename}{TABLA}}
\addto\captionsspanish{\renewcommand{\contentsname}{Contenido}}
\addto\captionsspanish{\renewcommand{\listtablename}{Índice de tablas}}
\addto\captionsspanish{\renewcommand{\listfigurename}{Índice de figuras}}
